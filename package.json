{
  "name": "quiet-hours",
  "version": "0.1.0",
  "description": "An isometric room drawn in 2D canvas, one asset per file, snapped to thirty-nine inks.",
  "private": true,
  "scripts": {
    "dev": "node tools/dev.js",
    "preview": "node tools/preview.js docs/preview.png 4.2 1100 760 1",
    "preview:dark": "node tools/preview.js docs/lights-out.png 4.2 1100 760 0",
    "build": "node tools/build.js",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "canvas": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
